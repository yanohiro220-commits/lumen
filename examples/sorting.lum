# Quicksort and binary search over lists.
#= [1, 1, 2, 3, 3, 4, 5, 5, 5, 6, 9]
#= 5
#= -1
#= true

fn concat(a, b) { return a + b; }

fn quicksort(xs) {
  if (len(xs) <= 1) { return xs; }

  let pivot = xs[0];
  let less = [];
  let same = [];
  let more = [];

  for (let i = 0; i < len(xs); i = i + 1) {
    let v = xs[i];
    if (v < pivot) { push(less, v); }
    else if (v > pivot) { push(more, v); }
    else { push(same, v); }
  }
  return concat(concat(quicksort(less), same), quicksort(more));
}

let data = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5];
let sorted = quicksort(data);
print sorted;

# Binary search returns an index, or -1 when the value is absent.
fn binary_search(xs, target) {
  let lo = 0;
  let hi = len(xs) - 1;
  while (lo <= hi) {
    let mid = floor((lo + hi) / 2);
    if (xs[mid] == target) { return mid; }
    if (xs[mid] < target) { lo = mid + 1; } else { hi = mid - 1; }
  }
  return -1;
}

print binary_search(sorted, 4);
print binary_search(sorted, 7);

fn is_sorted(xs) {
  for (let i = 1; i < len(xs); i = i + 1) {
    if (xs[i] < xs[i - 1]) { return false; }
  }
  return true;
}
print is_sorted(sorted);
